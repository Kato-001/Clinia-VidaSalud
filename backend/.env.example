APP_NAME=MediTurno
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/La_Paz

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# PostgreSQL de Supabase (proyecto "mediturno").
# Supabase > Connect > Session pooler. Reemplace [CONTRASEÑA] por la contraseña de la base de datos
# (si no la conoce: Project Settings > Database > Reset database password).
DB_CONNECTION=pgsql
DB_HOST=aws-1-sa-east-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.hkxiujujwnzdgulwoxnu
DB_PASSWORD=[CONTRASEÑA]
DB_SSLMODE=require

# Sesiones y caché en archivos: no se crean tablas fuera del diagrama
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

